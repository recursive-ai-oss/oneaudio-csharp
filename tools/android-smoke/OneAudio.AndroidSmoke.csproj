<Project Sdk="Microsoft.NET.Sdk">
  <!-- Not part of the solution: a NativeAOT console program for Android (linux-bionic) that plays a quiet tone through the AAudio backend.
       tools/android-smoke/run.sh builds it with the Android NDK's clang, pushes it over adb and runs it in a shell on the device. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>oneaudio-android-smoke</AssemblyName>
    <RootNamespace>OneAudio.AndroidSmoke</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <OneAudioRoot Condition="'$(OneAudioRoot)' == ''">$(MSBuildThisFileDirectory)../../</OneAudioRoot>

    <!-- The SDK does not list linux-bionic as a NativeAOT target: point the compiler at the host compiler package, the target runtime pack and
         the NDK's clang and sysroot (ANDROID_NDK names the NDK folder). -->
    <_NdkLlvm>$(ANDROID_NDK)/toolchains/llvm/prebuilt/linux-x86_64</_NdkLlvm>
    <_Packages>$(NuGetPackageRoot)</_Packages>
    <_Packages Condition="'$(_Packages)' == ''">$(NUGET_PACKAGES)</_Packages>
    <_Packages>$([MSBuild]::EnsureTrailingSlash('$(_Packages)'))</_Packages>
    <_RuntimeVersion>$(BundledNETCoreAppPackageVersion)</_RuntimeVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux-bionic'))">
    <CppCompilerAndLinker>$(_NdkLlvm)/bin/clang</CppCompilerAndLinker>
    <SysRoot>$(_NdkLlvm)/sysroot</SysRoot>
    <ObjCopyName>$(_NdkLlvm)/bin/llvm-objcopy</ObjCopyName>
    <LinkerFlavor>lld</LinkerFlavor>
    <IlcToolsPath>$(_Packages)runtime.$(NETCoreSdkPortableRuntimeIdentifier.ToLowerInvariant()).microsoft.dotnet.ilcompiler/$(_RuntimeVersion)/tools/</IlcToolsPath>
    <_RuntimePack>$(_Packages)microsoft.netcore.app.runtime.nativeaot.$(RuntimeIdentifier)/$(_RuntimeVersion)/runtimes/$(RuntimeIdentifier)/</_RuntimePack>
    <IlcFrameworkPath>$(_RuntimePack)lib/net10.0/</IlcFrameworkPath>
    <IlcFrameworkNativePath>$(_RuntimePack)native/</IlcFrameworkNativePath>
    <IlcSdkPath>$(_RuntimePack)native/</IlcSdkPath>
  </PropertyGroup>

  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux-bionic'))">
    <PackageDownload Condition="'$(_IsPublishing)' != 'true'" Include="runtime.$(NETCoreSdkPortableRuntimeIdentifier).Microsoft.DotNet.ILCompiler" Version="[$(_RuntimeVersion)]" />
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.NativeAOT.$(RuntimeIdentifier)" Version="[$(_RuntimeVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(OneAudioRoot)src/OneAudio/OneAudio.csproj" />
    <ProjectReference Include="$(OneAudioRoot)src/OneAudio.Devices/OneAudio.Devices.csproj" />
  </ItemGroup>
</Project>
