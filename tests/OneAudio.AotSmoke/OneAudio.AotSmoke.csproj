<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test-stream generators, shared with the unit tests so the Vorbis check decodes bytes we produced. -->
    <Compile Include="../OneAudio.Tests/OggBuilder.cs" Link="Shared/OggBuilder.cs" />
    <Compile Include="../OneAudio.Tests/VorbisStreamBuilder.cs" Link="Shared/VorbisStreamBuilder.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../testdata/flac/stereo16_midside_small.flac" LogicalName="smoke.flac" />
    <EmbeddedResource Include="../../testdata/flac/ogg_stereo16.oga" LogicalName="smoke.oga" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OneAudio/OneAudio.csproj" />
  </ItemGroup>
</Project>
