<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1707;CA1861;xUnit1051;xUnit1031</NoWarn>
    <!-- The allocation tests read GC.GetAllocatedBytesForCurrentThread around single calls. A background (concurrent) GC, which a
         large allocation on the same thread can start, suspends the thread mid-call and shifts that per-thread counter by the
         unused part of its allocation buffer, which shows up as a few KB of phantom allocation. Blocking GCs run on the
         allocating thread, outside the measured calls. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../testdata/fuzz/**" Link="testdata/fuzz/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../testdata/opus/*.opus" Link="testdata/opus/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../testdata/mp3/*.mp3" Link="testdata/mp3/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OneAudio/OneAudio.csproj" />
  </ItemGroup>
</Project>
