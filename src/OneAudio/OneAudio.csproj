<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>$(OneAudioPackageId)</PackageId>
    <!-- The release workflow checks the tag against this; pass -p:Version=... to override. -->
    <Version Condition="'$(Version)' == ''">1.1.0</Version>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Description>Audio decode, encode, resample, mix and analyse for .NET, with no dependencies beyond the base class library.</Description>
    <!-- Kernels/ is the only place unsafe code is allowed. It lives in this assembly, and AllowUnsafeBlocks
         stays false until a kernel needs it. When one does, the kernels move to their own internal assembly
         so the parsing code can never be compiled with unsafe enabled. -->
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/recursive-ai-oss/oneaudio-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/recursive-ai-oss/oneaudio-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageTags>audio;wav;flac;vorbis;opus;mp3;ogg;resampler;mixer;loudness;ebu-r128;nativeaot</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
    <None Include="icon.png" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-MIT" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-APACHE" Pack="true" PackagePath="/" />
    <!-- Shipped when the repository has one; packing works without it. -->
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" Condition="Exists('$(MSBuildThisFileDirectory)../../CHANGELOG.md')" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OneAudio.Tests" />
  </ItemGroup>
</Project>
